{
  "compilerOptions": {
    // --- Configuração do Output ---
    "outDir": "./build", // A pasta onde os arquivos .js serão criados.
    "rootDir": "./src", // A pasta raiz que contém todo o seu código .ts.

    // --- Configuração do Módulo e Target ---
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": "./src"
  },
  "include": ["src", "src/database/prisma", "src/**/*.ts"],
  "exclude": ["node_modules"]
}
