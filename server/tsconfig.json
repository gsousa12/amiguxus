{
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "./src",

    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": "./src"
  },
  "include": ["src", "src/database/prisma", "src/**/*.ts"],
  "exclude": ["node_modules"]
}
