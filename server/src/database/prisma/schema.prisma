generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PetSpecies {
  dog
  cat
}

enum PetAge {
  puppy
  adult
  senior
}

enum PetSize {
  small
  medium
  large
}

enum PetGender {
  male
  female
  unknown
}

enum PetStatus {
  available
  adopted
}

enum AdoptionRequestStatus {
  pending
  accepted
  rejected
}

model User {
  id                   String    @id @default(uuid())
  full_name            String
  phone                String? 
  email                String    @unique 
  hashed_password      String               
  city                 String           
  state                String          
  is_active            Boolean   @default(true)
  created_at           DateTime  @default(now()) @db.Timestamptz 
  updated_at           DateTime? @updatedAt @db.Timestamptz 

    // --- Mapeamento e Relations ---
  @@map("users")
  pets                 Pet[] 
  adoptionRequests     AdoptionRequest[]
  adoptions            Adoption[]
  favoritedPet         FavoritedPet[]
}

model Pet {
  id                   String    @id @default(uuid())
  owner_id              String    @default(uuid())
  name                 String
  species              PetSpecies
  breed                String?
  gender               PetGender
  age                  PetAge
  size                 PetSize
  description          String?
  vaccinated           Boolean
  neutered             Boolean
  status               PetStatus
  images_urls           String[]
  city                 String
  state                String
  created_at           DateTime  @default(now()) @db.Timestamptz 
  updated_at           DateTime? @updatedAt @db.Timestamptz 
  deleted_at           DateTime? @db.Timestamptz 

    // --- Mapeamento e Relations ---
  @@map("pets")
  owner                User             @relation(fields: [owner_id], references: [id])
  adoptionRequests     AdoptionRequest[]
  adoptions            Adoption? 
  favoritedPet         FavoritedPet[]
}

model Notification {
  id              String              @id @default(uuid())
  title           String
  message         String
  is_read         Boolean             @default(false) 
  related_user_id String              @db.Uuid
  created_at      DateTime            @default(now()) @db.Timestamptz 
  read_at         DateTime?           @db.Timestamptz 

  // --- Mapeamento e Relations ---
  @@map("notifications")
}

model AdoptionRequest {
  id                   String    @id @default(uuid())
  pet_id               String          
  request_user_id      String             
  status               AdoptionRequestStatus
  message              String
  created_at           DateTime  @default(now()) @db.Timestamptz 
  updated_at           DateTime? @updatedAt @db.Timestamptz 

  // --- Mapeamento e Relations ---
  @@map("adoption_requests")
  pet                  Pet              @relation(fields: [pet_id], references: [id])
  user                 User             @relation(fields: [request_user_id], references: [id])

  // --- Unique Constraint  ---
  @@unique([pet_id, request_user_id])
}

model Adoption {
  id                   String    @id @default(uuid())
  pet_id               String    @unique
  adopter_id           String         
  status               AdoptionRequestStatus
  created_at           DateTime  @default(now()) @db.Timestamptz 
  updated_at           DateTime? @updatedAt @db.Timestamptz 

  // --- Mapeamento e Relations ---
  @@map("adoptions")
  pet                  Pet             @relation(fields: [pet_id], references: [id])
  user                 User            @relation(fields: [adopter_id], references: [id])

  // --- Unique Constraint  ---
  @@unique([pet_id, adopter_id])
}

model FavoritedPet {
  id          String    @id @default(uuid())
  user_id     String     
  pet_id      String   
  createdAt   DateTime @default(now()) @map("created_at")

  // --- Mapeamento e Relations ---
  @@map("favorited_pets")
  user       User     @relation(fields: [user_id], references: [id])
  pet        Pet      @relation(fields: [pet_id], references: [id])

  // --- Unique Constraint  ---
  @@unique([user_id, pet_id]) 
}

